{
  "manifest_version": "dashboard-sources.v1",
  "sources": [
    {
      "name": "scheduler_heartbeat",
      "path_template": "{data_root}/runtime/scheduler_heartbeat.json",
      "format": "json",
      "canonicality": "CANONICAL",
      "producer": "scheduler",
      "expected_freshness_seconds": 1800,
      "read_strategy": "bounded_atomic_json_snapshot",
      "redaction": "allowlisted_fields_only",
      "configured_availability": "required",
      "join_keys": ["deployment_id", "pid", "git_commit_sha", "config_hash"],
      "limitations": ["latest state only", "not a historical health ledger"]
    },
    {
      "name": "scheduler_lock",
      "path_template": "{scheduler_lock}",
      "format": "json",
      "canonicality": "CANONICAL",
      "producer": "scheduler instance guard",
      "expected_freshness_seconds": 1800,
      "read_strategy": "bounded_json_snapshot",
      "redaction": "allowlisted_fields_only",
      "configured_availability": "optional",
      "join_keys": ["pid", "deployment_id"],
      "limitations": ["must be configured explicitly because the filename is deployment-specific", "not a heartbeat"]
    },
    {
      "name": "scan_runs",
      "path_template": "{data_root}/scan_runs/**/*.json",
      "format": "json_files",
      "canonicality": "CANONICAL",
      "producer": "FileScanRunRepository",
      "expected_freshness_seconds": 1800,
      "read_strategy": "incremental_immutable_files_ignore_tmp",
      "redaction": "structured_fields",
      "configured_availability": "required",
      "join_keys": ["id", "timestamps"],
      "limitations": ["cycle_number is not persisted"]
    },
    {
      "name": "market_snapshots",
      "path_template": "{data_root}/market_snapshots/**/*.json",
      "format": "json_files",
      "canonicality": "CANONICAL",
      "producer": "market scan",
      "expected_freshness_seconds": 1800,
      "read_strategy": "incremental_immutable_files_ignore_tmp",
      "redaction": "structured_fields",
      "configured_availability": "required",
      "join_keys": ["id", "scan_run_id", "symbol", "timeframe", "timestamp"],
      "limitations": ["not a complete OHLC history", "reevaluations create new snapshot IDs"]
    },
    {
      "name": "strategy_evaluations",
      "path_template": "{data_root}/strategy_evaluations/**/*.json",
      "format": "json_files",
      "canonicality": "CANONICAL",
      "producer": "strategy engine",
      "expected_freshness_seconds": 1800,
      "read_strategy": "incremental_immutable_files_ignore_tmp",
      "redaction": "structured_fields",
      "configured_availability": "required",
      "join_keys": ["id", "scan_run_id", "entry_snapshot_id", "higher_snapshot_id"],
      "limitations": ["decision trace is textual", "agent receipts are not persisted here"]
    },
    {
      "name": "trade_signals",
      "path_template": "{data_root}/trade_signals/**/*.json",
      "format": "json_files",
      "canonicality": "CANONICAL",
      "producer": "market scan and FileSignalRepository",
      "expected_freshness_seconds": 1800,
      "read_strategy": "incremental_immutable_files_ignore_tmp",
      "redaction": "structured_fields",
      "configured_availability": "required",
      "join_keys": ["id", "scan_run_id", "evaluation_id", "risk_plan_id", "dedupe_key"],
      "limitations": ["observation_id is absent", "repeated reevaluations can share dedupe_key"]
    },
    {
      "name": "risk_plans",
      "path_template": "{data_root}/risk_plans/**/*.json",
      "format": "json_files",
      "canonicality": "CANONICAL",
      "producer": "risk service",
      "expected_freshness_seconds": null,
      "read_strategy": "incremental_immutable_files_ignore_tmp",
      "redaction": "structured_fields",
      "configured_availability": "optional",
      "join_keys": ["id", "evaluation_id"],
      "limitations": ["not every evaluation has a persisted risk plan"]
    },
    {
      "name": "signal_deliveries",
      "path_template": "{data_root}/signal_deliveries/**/*.json",
      "format": "json_files",
      "canonicality": "CANONICAL",
      "producer": "publish_signal",
      "expected_freshness_seconds": null,
      "read_strategy": "incremental_immutable_files_ignore_tmp",
      "redaction": "drop_payload_recipient_provider_id",
      "configured_availability": "optional",
      "join_keys": ["id", "signal_id"],
      "limitations": ["contains sensitive delivery fields", "publication requires confirmed delivery semantics"]
    },
    {
      "name": "system_errors",
      "path_template": "{data_root}/system_errors/**/*.json",
      "format": "json_files",
      "canonicality": "CANONICAL",
      "producer": "FileScanRunRepository",
      "expected_freshness_seconds": null,
      "read_strategy": "incremental_immutable_files_ignore_tmp",
      "redaction": "redact_error_messages",
      "configured_availability": "optional",
      "join_keys": ["id", "scan_run_id"],
      "limitations": ["absence does not prove absence of scheduler errors"]
    },
    {
      "name": "paper_trades",
      "path_template": "{data_root}/paper_trading/trades.csv",
      "format": "csv",
      "canonicality": "MIXED",
      "producer": "PaperTradingStore",
      "expected_freshness_seconds": 1800,
      "read_strategy": "open_current_inode_parse_complete_csv",
      "redaction": "allowlisted_columns",
      "configured_availability": "required",
      "join_keys": ["trade_id", "dedupe_key", "statistical_key"],
      "limitations": ["mixed legacy and instrumented rows", "current tracker is non-canonical for performance"]
    },
    {
      "name": "paper_shadow_signals",
      "path_template": "{data_root}/paper_trading/shadow_signals.csv",
      "format": "csv",
      "canonicality": "DERIVED",
      "producer": "ShadowSignalStore",
      "expected_freshness_seconds": null,
      "read_strategy": "complete_csv_snapshot",
      "redaction": "allowlisted_columns",
      "configured_availability": "optional",
      "join_keys": ["timestamp", "symbol", "direction"],
      "limitations": ["no stable signal ID", "outcomes are not canonical"]
    },
    {
      "name": "paper_experimental_signals",
      "path_template": "{data_root}/paper_trading/experimental_signals.csv",
      "format": "csv",
      "canonicality": "NON_CANONICAL",
      "producer": "ExperimentalSignalStore",
      "expected_freshness_seconds": null,
      "read_strategy": "complete_csv_snapshot",
      "redaction": "allowlisted_columns",
      "configured_availability": "optional",
      "join_keys": ["timestamp", "symbol", "direction"],
      "limitations": ["manual outcome updater is not scheduled", "strategy versions are absent"]
    },
    {
      "name": "paper_modular_signals",
      "path_template": "{data_root}/paper_trading/modular_signals.csv",
      "format": "csv",
      "canonicality": "NON_CANONICAL",
      "producer": "ModularSignalStore",
      "expected_freshness_seconds": null,
      "read_strategy": "complete_csv_snapshot",
      "redaction": "allowlisted_columns",
      "configured_availability": "optional",
      "join_keys": ["timestamp", "symbol", "direction"],
      "limitations": ["manual outcome updater is not scheduled", "current production engine is legacy"]
    },
    {
      "name": "live_trades",
      "path_template": "{data_root}/live_trading/trades.csv",
      "format": "csv",
      "canonicality": "MIXED",
      "producer": "LiveTradingStore",
      "expected_freshness_seconds": null,
      "read_strategy": "complete_csv_snapshot",
      "redaction": "allowlisted_columns",
      "configured_availability": "optional",
      "join_keys": ["trade_id", "dedupe_key"],
      "limitations": ["legacy rows lack version and cost evidence", "must never be merged into paper KPIs"]
    },
    {
      "name": "shadow_relaxation_trades",
      "path_template": "{data_root}/shadow_relaxation/trades.csv",
      "format": "csv",
      "canonicality": "NON_CANONICAL",
      "producer": "RelaxationShadowV1Store",
      "expected_freshness_seconds": null,
      "read_strategy": "complete_csv_snapshot",
      "redaction": "allowlisted_columns",
      "configured_availability": "optional",
      "join_keys": ["trade_id", "dedupe_key"],
      "limitations": ["runtime identity and costs are absent", "shares current tracker defects"]
    },
    {
      "name": "shadow_relaxation_skips",
      "path_template": "{data_root}/shadow_relaxation/skips.csv",
      "format": "csv",
      "canonicality": "DERIVED",
      "producer": "RelaxationShadowV1Store",
      "expected_freshness_seconds": null,
      "read_strategy": "complete_csv_snapshot",
      "redaction": "allowlisted_columns",
      "configured_availability": "optional",
      "join_keys": [],
      "limitations": ["no stable ID", "not an outcome dataset"]
    },
    {
      "name": "shadow_blocks",
      "path_template": "{data_root}/shadow_blocks/*.csv",
      "format": "csv_files",
      "canonicality": "NON_CANONICAL",
      "producer": "shadow block use cases",
      "expected_freshness_seconds": null,
      "read_strategy": "incremental_complete_csv_files",
      "redaction": "allowlisted_columns",
      "configured_availability": "optional",
      "join_keys": ["candidate_id", "dedupe_key"],
      "limitations": ["version and freshness are inconsistent"]
    },
    {
      "name": "no_trade_diagnostics",
      "path_template": "{data_root}/diagnostics/no_trade_diagnostics/*.csv",
      "format": "csv_files",
      "canonicality": "DERIVED",
      "producer": "diagnostic store",
      "expected_freshness_seconds": 1800,
      "read_strategy": "closed_days_plus_current_file_snapshot",
      "redaction": "allowlisted_columns",
      "configured_availability": "optional",
      "join_keys": ["scan_run_id", "symbol", "timestamp"],
      "limitations": ["overlaps canonical evaluation data"]
    },
    {
      "name": "candidate_funnel",
      "path_template": "{data_root}/runtime/candidate_funnel_state.json",
      "format": "json",
      "canonicality": "CANONICAL",
      "producer": "candidate funnel use case",
      "expected_freshness_seconds": 1800,
      "read_strategy": "bounded_atomic_json_snapshot",
      "redaction": "structured_fields",
      "configured_availability": "required",
      "join_keys": ["scan_run_id"],
      "limitations": ["rolling last 50 cycles only", "counts are nested under cycles[].counts"]
    },
    {
      "name": "scheduler_diagnostic_window",
      "path_template": "{data_root}/scheduler_diagnostic_window.json",
      "format": "json",
      "canonicality": "DERIVED",
      "producer": "scheduler",
      "expected_freshness_seconds": 1800,
      "read_strategy": "bounded_atomic_json_snapshot",
      "redaction": "drop_unapproved_raw_payloads",
      "configured_availability": "optional",
      "join_keys": ["scan_run.id", "evaluation.id", "signal.id"],
      "limitations": ["rolling zero-to-four-cycle window", "not a persistent agent receipt ledger"]
    },
    {
      "name": "signal_activity_active",
      "path_template": "{active_signal_log}",
      "format": "jsonl",
      "canonicality": "DERIVED",
      "producer": "append_signal_log",
      "expected_freshness_seconds": 1800,
      "read_strategy": "incremental_complete_lines_with_rotation",
      "redaction": "allowlisted_fields_only",
      "configured_availability": "optional",
      "join_keys": ["dedupe_key", "signal_id", "evaluation_id"],
      "limitations": ["must be configured explicitly", "must not depend on release cwd"]
    },
    {
      "name": "signal_activity_stale_checkout",
      "path_template": "{data_root}/bot_activity/signals_log.jsonl",
      "format": "jsonl",
      "canonicality": "DERIVED",
      "producer": "historical scheduler cwd",
      "expected_freshness_seconds": null,
      "read_strategy": "historical_complete_lines_only",
      "redaction": "allowlisted_fields_only",
      "configured_availability": "optional",
      "join_keys": ["dedupe_key"],
      "limitations": ["known stale cutoff", "must never be labeled current"]
    },
    {
      "name": "pattern_memory",
      "path_template": "{data_root}/pattern_memory/patterns.jsonl",
      "format": "jsonl",
      "canonicality": "DERIVED",
      "producer": "PatternMemoryStore",
      "expected_freshness_seconds": 1800,
      "read_strategy": "incremental_complete_lines",
      "redaction": "allowlisted_fields_only",
      "configured_availability": "optional",
      "join_keys": ["symbol", "timestamp"],
      "limitations": ["no signal/evaluation ID", "outcomes are often open or null"]
    },
    {
      "name": "edge_knowledge",
      "path_template": "{data_root}/edge_knowledge/knowledge_v1.json",
      "format": "json",
      "canonicality": "DERIVED",
      "producer": "manual learning builder",
      "expected_freshness_seconds": null,
      "read_strategy": "bounded_json_snapshot",
      "redaction": "structured_fields",
      "configured_availability": "optional",
      "join_keys": ["knowledge context fields"],
      "limitations": ["manual generation", "stale during the audited window"]
    },
    {
      "name": "qic_agent_activity",
      "path_template": "{data_root}/qic/agent_activity.json",
      "format": "json",
      "canonicality": "DERIVED",
      "producer": "QIC activity writer",
      "expected_freshness_seconds": null,
      "read_strategy": "bounded_json_snapshot",
      "redaction": "allowlisted_fields_only",
      "configured_availability": "optional",
      "join_keys": ["agent name"],
      "limitations": ["aggregate executions are not per-signal receipts"]
    },
    {
      "name": "qic_autonomous_runs",
      "path_template": "{data_root}/qic/autonomous_runs.jsonl",
      "format": "jsonl",
      "canonicality": "CANONICAL",
      "producer": "QIC autonomous runtime",
      "expected_freshness_seconds": null,
      "read_strategy": "incremental_complete_lines",
      "redaction": "allowlisted_fields_only",
      "configured_availability": "optional",
      "join_keys": ["run_id", "input_fingerprint"],
      "limitations": ["timer was disabled during the audited window"]
    },
    {
      "name": "qic_decision_ledger",
      "path_template": "{data_root}/qic/decision_ledger.jsonl",
      "format": "jsonl",
      "canonicality": "CANONICAL",
      "producer": "QIC decision ledger",
      "expected_freshness_seconds": null,
      "read_strategy": "incremental_complete_lines",
      "redaction": "redact_narrative_fields",
      "configured_availability": "optional",
      "join_keys": ["decision_id", "proposal_id"],
      "limitations": ["not linked to signal evaluations"]
    },
    {
      "name": "qic_proposals",
      "path_template": "{data_root}/agent_proposals/proposals.jsonl",
      "format": "jsonl",
      "canonicality": "CANONICAL",
      "producer": "QIC proposal store",
      "expected_freshness_seconds": null,
      "read_strategy": "incremental_complete_lines",
      "redaction": "redact_narrative_fields",
      "configured_availability": "optional",
      "join_keys": ["proposal_id", "knowledge_item_id"],
      "limitations": ["not a signal-agent receipt ledger"]
    },
    {
      "name": "qic_system_health",
      "path_template": "{reports_root}/qic/system_health.json",
      "format": "json",
      "canonicality": "DERIVED",
      "producer": "qic-health.service",
      "expected_freshness_seconds": 600,
      "read_strategy": "bounded_atomic_json_snapshot",
      "redaction": "allowlisted_fields_only",
      "configured_availability": "optional",
      "join_keys": ["generated_at", "component name"],
      "limitations": ["latest state only"]
    },
    {
      "name": "qic_telegram_health",
      "path_template": "{reports_root}/qic/telegram_listener.json",
      "format": "json",
      "canonicality": "DERIVED",
      "producer": "qic-telegram-listener.service",
      "expected_freshness_seconds": 300,
      "read_strategy": "bounded_atomic_json_snapshot",
      "redaction": "drop_chat_ids_and_payloads",
      "configured_availability": "optional",
      "join_keys": ["update offset", "timestamp"],
      "limitations": ["listener health is distinct from delivery health"]
    },
    {
      "name": "research_reports",
      "path_template": "{reports_root}/**/*",
      "format": "mixed_files",
      "canonicality": "DERIVED",
      "producer": "manual and scheduled report jobs",
      "expected_freshness_seconds": null,
      "read_strategy": "allowlisted_schemas_with_generated_at",
      "redaction": "report_specific_allowlists",
      "configured_availability": "optional",
      "join_keys": [],
      "limitations": ["many reports are stale", "missing generated_at must be treated as no evidence"]
    },
    {
      "name": "binance_market",
      "path_template": "",
      "format": "external_json_api",
      "canonicality": "EXTERNAL",
      "producer": "Binance",
      "expected_freshness_seconds": null,
      "read_strategy": "disabled_in_foundation",
      "redaction": "no_credentials",
      "configured_availability": "disabled",
      "join_keys": ["symbol", "timeframe", "close_time"],
      "limitations": ["network integration is outside foundation scope"]
    }
  ]
}
