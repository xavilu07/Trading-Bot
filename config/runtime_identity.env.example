# Required runtime identity for a production scheduler.
# Values must match the effective checkout and code; mismatches abort startup.
GIT_COMMIT_SHA=replace-with-full-checkout-sha
DEPLOYMENT_ID=replace-with-unique-deployment-id
SELECTED_ENGINE=legacy
STRATEGY_VERSION=v1
POLICY_VERSION=v1
EXPERIMENT_ID=none

# Optional assertion. Leave empty to use the deterministic value logged at startup.
# If set, it must equal the value computed from the documented safe allowlist.
CONFIG_HASH=

# Never enable this in production. It only relaxes DEPLOYMENT_ID in development/tests.
RUNTIME_ALLOW_UNKNOWN_IDENTITY=false
