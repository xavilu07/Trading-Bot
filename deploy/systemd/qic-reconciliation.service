[Unit]
Description=Quantum Investment Council Reconciliation (real trades vs proposals)

[Service]
Type=oneshot
WorkingDirectory=/root/bot
Environment=PYTHONPATH=/root/bot/src
EnvironmentFile=-/root/bot/.env
ExecStart=/root/bot/.venv/bin/python /root/bot/scripts/run_qic_reconciliation.py
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
