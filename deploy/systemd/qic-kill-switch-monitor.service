[Unit]
Description=Trip the manual trading-pause latch on kill-switch conditions

[Service]
Type=oneshot
WorkingDirectory=/root/bot
Environment=PYTHONPATH=/root/bot/src
EnvironmentFile=-/root/bot/.env
ExecStart=/root/bot/.venv/bin/python /root/bot/scripts/run_kill_switch_monitor.py
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
