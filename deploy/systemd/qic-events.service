[Unit]
Description=Quantum Investment Council Event Detection

[Service]
Type=oneshot
WorkingDirectory=/root/bot
Environment=PYTHONPATH=/root/bot/src
ExecStart=/root/bot/.venv/bin/python /root/bot/scripts/run_qic_autonomous.py --once --phase events --phase notifications
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
