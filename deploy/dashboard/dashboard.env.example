# Future local-only listeners. Do not expose these ports directly.
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8101
DASHBOARD_FRONTEND_HOST=127.0.0.1
DASHBOARD_FRONTEND_PORT=3101

# Read-only source roots. Override per checkout/deployment.
DASHBOARD_BOT_ROOT=/root/bot
DASHBOARD_DATA_ROOT=/root/bot/data
DASHBOARD_REPORTS_ROOT=/root/bot/reports
DASHBOARD_RUNTIME_ROOT=/root/trading-bot-runtime

# Deployment-specific sources have no implicit release-cwd fallback.
# DASHBOARD_ACTIVE_SIGNAL_LOG=/path/to/active/data/bot_activity/signals_log.jsonl
# DASHBOARD_SCHEDULER_LOCK=/path/to/active/scheduler.lock
