APP_ENV=development
LOG_LEVEL=INFO
BINANCE_BASE_URL=https://api.binance.com/api/v3/klines
BINANCE_MARKET_TYPE=spot
SCAN_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,DOGEUSDT,AVAXUSDT
ENTRY_TIMEFRAME=1h
HIGHER_TIMEFRAME=4h
SETUP_SCORE_THRESHOLD=45
ATR_MIN_THRESHOLD=0.002
MAX_DISTANCE_TO_LIQUIDITY_ATR=2.5
MIN_BODY_RATIO=0.35
RISK_PER_TRADE=0.01
MIN_RR=2.0
ACCOUNT_BALANCE_REFERENCE=1000
SCAN_INTERVAL_SECONDS=900
PUBLISH_SIGNAL_DECISIONS=both
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_USERS_FILE=./telegram_users.json
TELEGRAM_STATE_FILE=./telegram_state.json
TELEGRAM_LISTENER_SLEEP_SECONDS=5
TELEGRAM_DIAGNOSTIC_SUMMARY_ENABLED=true
TELEGRAM_DIAGNOSTIC_SUMMARY_EVERY_CYCLES=5
SCHEDULER_DIAGNOSTIC_STATE_FILE=./data/scheduler_diagnostic_window.json
LIVE_TRADE_TRACKING_ENABLED=true
LIVE_BREAKEVEN_ALERT_ENABLED=true
LIVE_BREAKEVEN_TRIGGER_R=1.0
LIVE_PARTIAL_TP_ALERT_ENABLED=true
LIVE_PARTIAL_TP_TRIGGER_R=1.5
LIVE_PARTIAL_TP_PERCENTAGE_SUGGESTION=30-50
TELEGRAM_LIVE_DAILY_SUMMARY_ENABLED=true
LIVE_TRADING_SUMMARY_STATE_FILE=./data/live_trading/daily_summary_state.json
DATA_STORAGE_PATH=./data
DIAGNOSTICS_PATH=./data/diagnostics
